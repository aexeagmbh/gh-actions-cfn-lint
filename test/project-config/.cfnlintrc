---
# The old setup: a leftover `append_rules` in the project's own .cfnlintrc. The
# action's --append-rules replaces it, so it is never read; this checks that it
# does not break the run while requirements.in holds cfn-lint below 1.59, which
# refuses it. Removed with that cap. test.yml copies a template from
# ../templates to template.yaml before each run.
templates:
  - template.yaml
append_rules:
  - cfn_lint_ax.rules
  - cfn_lint_ax.serverless_rules
